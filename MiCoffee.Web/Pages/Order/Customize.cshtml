@page "{productId:int}"
@model MiCoffee.Web.Pages.Order.CustomizeModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Personalizar";
}

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Product is null)
{
    <a class="btn btn-outline-secondary" asp-page="/Index">Regresar</a>
    return;
}

<h1 class="h3">@Model.Product.Name</h1>
<p class="mb-3">Precio base: $@Model.Product.BasePrice.ToString("N2")</p>

<form method="post" asp-route-productId="@Model.Product.ProductId">
    @foreach (var group in Model.OptionGroups)
    {
        <fieldset class="mb-3">
            <legend class="h5">@group.Key</legend>
            @foreach (var option in group)
            {
                <div class="form-check option-check">
                    <input class="form-check-input" type="checkbox" name="SelectedOptionIds"
                           value="@option.ProductOptionId" id="opt-@option.ProductOptionId"
                           checked="@Model.SelectedOptionIds.Contains(option.ProductOptionId)" />
                    <label class="form-check-label" for="opt-@option.ProductOptionId">
                        @option.Name
                        @if (option.ExtraPrice > 0)
                        {
                            <span class="text-muted">(+$@option.ExtraPrice.ToString("N2"))</span>
                        }
                    </label>
                </div>
            }
        </fieldset>
    }

    <div class="mb-3">
        <label class="form-label" asp-for="Quantity">Cantidad</label>
        <input class="form-control" asp-for="Quantity" type="number" min="1" />
        <span class="text-danger" asp-validation-for="Quantity"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Note">Nota (opcional)</label>
        <input class="form-control" asp-for="Note" maxlength="255" />
        <span class="text-danger" asp-validation-for="Note"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Agregar al carrito</button>
        <a class="btn btn-outline-secondary" asp-page="/Index">Regresar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
