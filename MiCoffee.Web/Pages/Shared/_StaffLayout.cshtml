<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiCoffee Personal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chelsea+Market&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="staff-body">
    <header class="staff-header">
        <div class="staff-header-box d-flex align-items-center justify-content-between flex-wrap gap-2">
            <a class="staff-brand" href="/Staff">
                <img class="staff-logo" src="~/images/logo_MiCoffee.png" alt="Logo de MiCoffee" />
                <span class="staff-brand-name">MiCoffee</span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="d-flex align-items-center flex-wrap gap-3">
                    <a class="staff-link" href="/Staff">Inicio</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="staff-link" asp-page="/Staff/Users/Index">Usuarios</a>
                        <span class="staff-link text-muted">Catálogo </span>
                    }

                    <span class="staff-link text-muted">Órdenes</span>
                    <span class="staff-link text-muted">Inventario </span>
                    <span class="staff-link text-muted">Proveedores </span>

                    <span class="fw-semibold">@User.Identity.Name</span>

                    <form method="post" asp-page="/Staff/Logout" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-dark">Cerrar sesión</button>
                    </form>
                </nav>
            }
        </div>
    </header>

    <main class="staff-main">
        <div class="staff-content">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }

            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>