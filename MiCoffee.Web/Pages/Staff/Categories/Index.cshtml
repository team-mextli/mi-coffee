@page
@model MiCoffee.Web.Pages.Staff.Categories.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Categorías de producto</h1>
    <a asp-page="./Create" class="btn btn-primary">Nueva categoría</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Categories.Count == 0)
{
    <p>Aún no hay categorías. Crea la primera para poder agregar productos.</p>
}
else
{
    <div class="mc-card table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@category.ProductCategoryId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="./Delete" asp-route-id="@category.ProductCategoryId" class="btn btn-sm btn-outline-secondary">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
