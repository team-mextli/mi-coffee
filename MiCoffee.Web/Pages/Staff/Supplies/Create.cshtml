@page
@model MiCoffee.Web.Pages.Staff.Supplies.CreateModel
@{
    ViewData["Title"] = "Nuevo insumo";
}

<h1 class="h3 mb-3">Nuevo insumo</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (!Model.CanEdit)
{
    <a class="btn btn-outline-secondary" asp-page="/Staff/Supplies/Index">Regresar</a>
    return;
}

<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Supply.Name">Nombre</label>
        <input class="form-control" asp-for="Supply.Name" maxlength="100" />
        <span class="text-danger" asp-validation-for="Supply.Name"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Supply.SupplyCategoryId">Categoría</label>
        <select class="form-select" asp-for="Supply.SupplyCategoryId" asp-items="Model.Categories">
            <option value="0">Selecciona una categoría</option>
        </select>
        <span class="text-danger" asp-validation-for="Supply.SupplyCategoryId"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Supply.SupplierId">Proveedor (opcional)</label>
        <select class="form-select" asp-for="Supply.SupplierId" asp-items="Model.Suppliers">
            <option value="">Sin proveedor</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Supply.Unit">Unidad de medida</label>
        <input class="form-control" asp-for="Supply.Unit" maxlength="20" />
        <span class="text-danger" asp-validation-for="Supply.Unit"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Supply.CurrentStock">Existencia inicial</label>
        <input class="form-control" asp-for="Supply.CurrentStock" type="number" step="0.01" min="0" />
        <span class="text-danger" asp-validation-for="Supply.CurrentStock"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Supply.MinimumStock">Límite mínimo</label>
        <input class="form-control" asp-for="Supply.MinimumStock" type="number" step="0.01" min="0" />
        <span class="text-danger" asp-validation-for="Supply.MinimumStock"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar insumo</button>
        <a class="btn btn-outline-secondary" asp-page="/Staff/Supplies/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
