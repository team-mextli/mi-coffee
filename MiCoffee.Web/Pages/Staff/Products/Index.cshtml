@page
@model MiCoffee.Web.Pages.Staff.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Productos</h1>
    <a asp-page="./Create" class="btn btn-primary">Nuevo producto</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Products.Count == 0)
{
    <p>Aún no hay productos. Crea el primero para que aparezca en el menú.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio base</th>
                    <th>Disponible</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td class="text-end">$@product.BasePrice.ToString("N2")</td>
                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No disponible</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="./Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-secondary">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
