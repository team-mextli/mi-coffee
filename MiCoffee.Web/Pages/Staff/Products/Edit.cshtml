@page "{id:int}"
@model MiCoffee.Web.Pages.Staff.Products.EditModel
@using MiCoffee.Entities
@{
    ViewData["Title"] = "Editar producto";
}

<h1 class="h3 mb-3 text-center">Editar producto</h1>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mc-form">@Model.Error</div>
}

@if (Model.Loaded)
{
    <div class="mc-card mc-form">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Product.Name" class="form-label">Nombre</label>
                <input asp-for="Product.Name" class="form-control" autocomplete="off" />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Product.ProductCategoryId" class="form-label">Categoría</label>
                <select asp-for="Product.ProductCategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="0">Selecciona una categoría</option>
                </select>
                <span asp-validation-for="Product.ProductCategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Product.BasePrice" class="form-label">Precio base</label>
                <input asp-for="Product.BasePrice" type="number" step="0.01" min="0" class="form-control" />
                <div class="form-text">Precio sin opciones.</div>
                <span asp-validation-for="Product.BasePrice" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Product.IsAvailable" class="form-check-input" />
                <label asp-for="Product.IsAvailable" class="form-check-label">Disponible para pedir</label>
            </div>

            <div class="mb-4">
                <label class="form-label">Opciones permitidas</label>
                @if (Model.OptionGroups.Count == 0)
                {
                    <p class="form-text mb-0">
                        Aún no hay opciones. Puedes crearlas en <a asp-page="/Staff/Options/Create">Opciones</a>.
                    </p>
                }
                else
                {
                    foreach (var group in Model.OptionGroups)
                    {
                        <fieldset class="mb-2">
                            <legend class="fs-6 fw-semibold mb-1">@group.Key</legend>
                            @foreach (ProductOption option in group)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedOptionIds"
                                           id="option-@option.ProductOptionId"
                                           value="@option.ProductOptionId"
                                           checked="@Model.SelectedOptionIds.Contains(option.ProductOptionId)" />
                                    <label class="form-check-label" for="option-@option.ProductOptionId">
                                        @option.Name
                                        @if (option.ExtraPrice > 0)
                                        {
                                            <span class="form-text">(+$@option.ExtraPrice.ToString("N2"))</span>
                                        }
                                    </label>
                                </div>
                            }
                        </fieldset>
                    }
                }
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
}
else
{
    <div class="text-center">
        <a asp-page="./Index" class="btn btn-secondary">Regresar</a>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
