@page
@model MiCoffee.Web.Pages.Staff.Users.IndexModel
@using MiCoffee.Entities
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Usuarios del personal</h1>
    <a asp-page="./Create" class="btn btn-primary">Nuevo usuario</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="mc-card table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.StaffUsers)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Username</td>
                    <td>@(user.Role == UserRole.Admin ? "Administrador" : "Empleado")</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-page="./Edit" asp-route-id="@user.UserId"
                           class="btn btn-sm btn-outline-primary">Editar</a>

                        <form method="post" asp-page-handler="SetActive"
                              asp-route-id="@user.UserId"
                              asp-route-active="@(!user.IsActive)"
                              class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(user.IsActive ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>