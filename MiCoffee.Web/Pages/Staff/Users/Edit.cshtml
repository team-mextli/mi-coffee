@page "{id:int}"
@model MiCoffee.Web.Pages.Staff.Users.EditModel
@{
    ViewData["Title"] = "Editar usuario";
}

<h1 class="h3 mb-3 text-center">Editar usuario</h1>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mc-form">@Model.Error</div>
}

@if (!Model.Loaded)
{
    <div class="text-center">
        <a asp-page="./Index" class="btn btn-secondary">Regresar</a>
    </div>
}
else
{
    <div class="mc-card mc-form">
        <form method="post">
            <input type="hidden" asp-for="StaffUser.UserId" />

            <div class="mb-3">
                <label asp-for="StaffUser.FullName" class="form-label">Nombre completo</label>
                <input asp-for="StaffUser.FullName" class="form-control" />
                <span asp-validation-for="StaffUser.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StaffUser.Username" class="form-label">Usuario</label>
                <input asp-for="StaffUser.Username" class="form-control" autocomplete="off" />
                <span asp-validation-for="StaffUser.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StaffUser.Role" class="form-label">Rol</label>
                <select asp-for="StaffUser.Role" asp-items="Model.Roles" class="form-select"></select>
            </div>

            <div class="mb-4">
                <label asp-for="NewPassword" class="form-label">Nueva contraseña</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <div class="form-text">Déjala vacía para conservar la actual.</div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}