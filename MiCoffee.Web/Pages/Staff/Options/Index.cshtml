@page
@model MiCoffee.Web.Pages.Staff.Options.IndexModel
@{
    ViewData["Title"] = "Opciones";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Opciones de personalización</h1>
    <a asp-page="./Create" class="btn btn-primary">Nueva opción</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.ProductOptions.Count == 0)
{
    <p>Aún no hay opciones. Crea la primera, por ejemplo del grupo Tamaño o Leche.</p>
}
else
{
    <div class="mc-card table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Grupo</th>
                    <th>Nombre</th>
                    <th class="text-end">Precio adicional</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var option in Model.ProductOptions)
                {
                    <tr>
                        <td>@option.OptionGroup</td>
                        <td>@option.Name</td>
                        <td class="text-end">$@option.ExtraPrice.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a asp-page="./Edit" asp-route-id="@option.ProductOptionId" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-page="./Delete" asp-route-id="@option.ProductOptionId" class="btn btn-sm btn-outline-secondary">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
