@page "{id:int}"
@model MiCoffee.Web.Pages.Staff.Options.DeleteModel
@{
    ViewData["Title"] = "Eliminar opción";
}

<h1 class="h3 mb-3 text-center">Eliminar opción</h1>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger mc-form">@Model.Error</div>
}

@if (Model.ProductOption is not null)
{
    <div class="mc-card mc-form">
        <p class="mb-1">Grupo: <strong>@Model.ProductOption.OptionGroup</strong></p>
        <p class="mb-1">Nombre: <strong>@Model.ProductOption.Name</strong></p>
        <p class="mb-4">Precio adicional: <strong>$@Model.ProductOption.ExtraPrice.ToString("N2")</strong></p>

        @if (Model.CanDelete)
        {
            <p>¿Seguro que quieres eliminarla? También se quitará de los productos que la permiten. Esta acción no se puede deshacer.</p>

            <form method="post">
                <button type="submit" class="btn btn-primary">Eliminar</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
            </form>
        }
        else
        {
            <a asp-page="/Staff/Products/Index" class="btn btn-primary">Ir a productos</a>
            <a asp-page="./Index" class="btn btn-secondary">Regresar</a>
        }
    </div>
}
else
{
    <div class="text-center">
        <a asp-page="./Index" class="btn btn-secondary">Regresar</a>
    </div>
}
