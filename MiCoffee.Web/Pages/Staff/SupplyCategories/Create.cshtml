@page
@model MiCoffee.Web.Pages.Staff.SupplyCategories.CreateModel
@{
    ViewData["Title"] = "Nueva categoría de insumo";
}

<h1 class="h3 mb-3">Nueva categoría de insumo</h1>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label" asp-for="Category.Name">Nombre</label>
        <input class="form-control" asp-for="Category.Name" maxlength="50" />
        <span class="text-danger" asp-validation-for="Category.Name"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar categoría</button>
        <a class="btn btn-outline-secondary" asp-page="/Staff/SupplyCategories/Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
