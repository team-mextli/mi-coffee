@page
@using MiCoffee.Entities
@using MiCoffee.Web.Helpers
@model MiCoffee.Web.Pages.Staff.Orders.HistoryModel
@{
    ViewData["Title"] = "Historial de órdenes";
}

<h1 class="h3 mb-3">Historial de órdenes</h1>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-3">
        <label class="form-label" for="FromDate">Desde</label>
        <input class="form-control" type="date" id="FromDate" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label" for="ToDate">Hasta</label>
        <input class="form-control" type="date" id="ToDate" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-3">
        <label class="form-label" for="Status">Estado</label>
        <select class="form-select" id="Status" name="Status">
            <option value="">Todos</option>
            @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@OrderStatusLabels.Text(status)</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-page="/Staff/Orders/History">Limpiar</a>
    </div>
</form>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (!Model.Orders.Any())
{
    <p>No hay órdenes con esos filtros.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Fecha y hora</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>#@order.CustomerOrderId</td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(order.CustomerName ?? "—")</td>
                        <td><span class="badge @OrderStatusLabels.BadgeClass(order.Status)">@OrderStatusLabels.Text(order.Status)</span></td>
                        <td class="text-end">$@order.Total.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Staff/Orders/Details" asp-route-id="@order.CustomerOrderId">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-outline-secondary" asp-page="/Staff/Orders/Index">Regresar</a>
