@page
@model MiCoffee.Web.Pages.IndexModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Menú";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Elige tu bebida o alimento</h1>
    <a class="btn btn-primary" asp-page="/Order/Cart">Ver carrito (@Model.CartCount)</a>
</div>

@if (Model.Error is not null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (!Model.Groups.Any())
{
    <p>Por ahora no hay productos disponibles.</p>
}

@foreach (var group in Model.Groups)
{
    <section class="mb-4">
        <h2 class="h4">@group.Key</h2>
        <div class="row g-3">
            @foreach (var product in group)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="product-card" asp-page="/Order/Customize" asp-route-productId="@product.ProductId">
                        <span class="product-name">@product.Name</span>
                        <span class="product-price">$@product.BasePrice.ToString("N2")</span>
                    </a>
                </div>
            }
        </div>
    </section>
}
